# Elecrow CrowPanel 1.28" HMI ESP32 Rotary Display: ESP32-S3R8 (8 MB octal PSRAM in the
# package), 16 MB flash, 1.28" round 240x240 GC9A01 on SPI, CST816D touch, a rotary encoder
# with a push switch, a ring of 5 WS2812 LEDs, console on the chip's USB Serial/JTAG.
# Loaded by every app before its own sdkconfig.defaults. See README.md here.

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ── Memory ──
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# CONFIG_SPIRAM_IGNORE_NOTFOUND is not set
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Code and constants run from PSRAM, copied there at boot (as on lcdwiki_es3c28p): the octal
# PSRAM fills a cache miss faster than the quad flash, and the engine and ThorVG miss a lot.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
# Bigger caches (the default 16 / 32 KB): the frame is drawn in PSRAM and the code is large.
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# ── Console: USB Serial/JTAG (the board's only USB port) ──
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ── BLE host memory in PSRAM ──
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# ── 3D on: 8 MB of PSRAM, a small screen ──
CONFIG_KOBENTOVG_3D=y
