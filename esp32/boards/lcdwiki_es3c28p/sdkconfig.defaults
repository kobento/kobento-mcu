# LCDWIKI ES3C28P "2.8inch ESP32-S3 Display": ESP32-S3 N16R8 (8 MB octal PSRAM, 16 MB flash),
# 2.8" 240x320 ILI9341V on SPI (used as 320x240), FT6336G touch, ES8311 audio, microSD, one
# WS2812, console on the chip's USB Serial/JTAG.
# Loaded by every app before its own sdkconfig.defaults. See README.md here.

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ── Memory ──
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# CONFIG_SPIRAM_IGNORE_NOTFOUND is not set
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Code and constants run from PSRAM, copied there at boot (~3 MB of the 8): the octal PSRAM
# fills a cache miss faster than the quad flash, and both cores' code misses a lot (the
# engine and ThorVG on one, the audio and noise removal on the other, one 32 KB cache).
# Writing flash (an update) no longer stalls them either.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# ── Console: USB Serial/JTAG (the USB-C port) ──
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ── BLE host memory in PSRAM ──
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# ── 3D on: 8 MB of PSRAM, a small screen ──
CONFIG_KOBENTOVG_3D=y

# Bigger caches: the frame is drawn in PSRAM (320x240 ARGB, 300 KB) and the engine's code
# runs from flash, so both caches see heavy traffic.
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
